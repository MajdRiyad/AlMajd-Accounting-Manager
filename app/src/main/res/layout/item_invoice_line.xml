<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Row number (1, 2, 3...) — updated by the adapter on every bind/delete -->
    <TextView
        android:id="@+id/tv_row_number"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold" />

    <!-- Item name (اسم الصنف) -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_item_name"
        style="@style/InputTextBox.LineItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="3"
        android:hint="@string/item_name"
        android:inputType="text"
        android:textSize="@dimen/text_size_body" />

    <!-- Quantity (الكمية) -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_quantity"
        style="@style/InputTextBox.LineItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:hint="@string/quantity"
        android:inputType="number"
        android:textSize="@dimen/text_size_body" />

    <!-- Unit price (سعر الواحدة) -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_unit_price"
        style="@style/InputTextBox.LineItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="2"
        android:digits="@string/amount_input_digits"
        android:gravity="center"
        android:hint="@string/unit_price"
        android:inputType="numberDecimal"
        android:textSize="@dimen/text_size_body" />

    <!-- Row total (المجموع) -->
    <TextView
        android:id="@+id/tv_subtotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="2"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold" />

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        app:tint="@color/red" />

</LinearLayout>
