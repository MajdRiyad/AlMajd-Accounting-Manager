<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightGray"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ===== HEADER (~150dp) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_header"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp">

                    <ImageButton
                        android:id="@+id/btn_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|top"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_title"
                        android:padding="8dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/white" />

                </FrameLayout>

                <!-- Company name (Arabic) -->
                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_title"
                    android:textAppearance="@style/TextAppearance.AlMajd.Title"
                    android:textColor="@color/white" />

                <!-- Company name (English) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_title_en"
                    android:textColor="@color/textOnPrimaryMuted"
                    android:textSize="@dimen/text_size_company_en" />

                <!-- Greeting -->
                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/greeting"
                    android:textColor="@color/textOnPrimarySoft"
                    android:textSize="@dimen/text_size_greeting" />

            </LinearLayout>

            <!-- ===== WEEKLY BACKUP REMINDER (amber) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_backup_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/backupCardBackground"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp"
                app:strokeColor="@color/amber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/amber" />

                        <TextView
                            android:id="@+id/tv_backup_reminder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_size_small" />

                        <ImageButton
                            android:id="@+id/btn_backup_reminder_dismiss"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/dismiss"
                            android:src="@drawable/ic_close"
                            app:tint="@color/textSecondary" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_backup_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="8dp"
                        android:text="@string/backup_now"
                        android:textSize="@dimen/text_size_small"
                        app:backgroundTint="@color/primaryColor"
                        app:cornerRadius="@dimen/button_corner_radius" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== STATS 2 x 3 (RTL order: sales, received / debts, customers / payments, invoices) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Total sales -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_total_sales"
                            android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                        <TextView
                            android:id="@+id/tv_stat_total_sales"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="none"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/primaryColor"
                            android:textSize="@dimen/text_size_stat_value"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="20sp"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Total received -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_total_received"
                            android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                        <TextView
                            android:id="@+id/tv_stat_total_received"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="none"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/green"
                            android:textSize="@dimen/text_size_stat_value"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="20sp"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Total debts -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_total_debts"
                            android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                        <TextView
                            android:id="@+id/tv_stat_total_debts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="none"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/red"
                            android:textSize="@dimen/text_size_stat_value"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="20sp"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Customer count -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_customer_count"
                            android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                        <TextView
                            android:id="@+id/tv_stat_customer_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="none"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/primaryColor"
                            android:textSize="@dimen/text_size_stat_value"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="20sp"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Payment count -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_payment_count"
                            android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                        <TextView
                            android:id="@+id/tv_stat_payment_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="none"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/primaryColor"
                            android:textSize="@dimen/text_size_stat_value"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="20sp"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Invoice count -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_invoice_count"
                            android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                        <TextView
                            android:id="@+id/tv_stat_invoice_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="none"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/primaryColor"
                            android:textSize="@dimen/text_size_stat_value"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="20sp"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== CUSTOMER CREDIT ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_total_credit"
                        android:textAppearance="@style/TextAppearance.AlMajd.Caption" />

                    <TextView
                        android:id="@+id/tv_stat_total_credit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="none"
                        android:gravity="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="0"
                        android:textColor="@color/green"
                        android:textSize="@dimen/text_size_stat_value"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="20sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== NAVIGATION 2 x 2 (all navy icons on a light circle, no borders) ===== -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:rowCount="2">

                <!-- Customers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_add_customer"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_card_height"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="@dimen/nav_icon_circle_size"
                            android:layout_height="@dimen/nav_icon_circle_size"
                            android:background="@drawable/bg_icon_circle_navy">

                            <ImageView
                                android:layout_width="@dimen/nav_icon_size"
                                android:layout_height="@dimen/nav_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_person"
                                app:tint="@color/primaryColor" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/nav_customers"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Invoices -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_new_invoice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_card_height"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="@dimen/nav_icon_circle_size"
                            android:layout_height="@dimen/nav_icon_circle_size"
                            android:background="@drawable/bg_icon_circle_navy">

                            <ImageView
                                android:layout_width="@dimen/nav_icon_size"
                                android:layout_height="@dimen/nav_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_new_invoice"
                                app:tint="@color/primaryColor" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/nav_invoices"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Payments -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_add_payment"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_card_height"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="@dimen/nav_icon_circle_size"
                            android:layout_height="@dimen/nav_icon_circle_size"
                            android:background="@drawable/bg_icon_circle_navy">

                            <ImageView
                                android:layout_width="@dimen/nav_icon_size"
                                android:layout_height="@dimen/nav_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_payment"
                                app:tint="@color/primaryColor" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/nav_payments"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Reports -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_reports"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_card_height"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="@dimen/nav_icon_circle_size"
                            android:layout_height="@dimen/nav_icon_circle_size"
                            android:background="@drawable/bg_icon_circle_navy">

                            <ImageView
                                android:layout_width="@dimen/nav_icon_size"
                                android:layout_height="@dimen/nav_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_reports"
                                app:tint="@color/primaryColor" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/nav_reports"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ===== RECENT INVOICES ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_invoices"
                            android:textAppearance="@style/TextAppearance.AlMajd.SectionHeader" />

                        <TextView
                            android:id="@+id/tv_view_all_invoices"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="@string/view_all"
                            android:textColor="@color/primaryColor"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/divider" />

                    <!-- Recent invoices list container -->
                    <LinearLayout
                        android:id="@+id/ll_recent_invoices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/tv_no_recent_invoices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="@string/no_recent_invoices"
                        android:textColor="@color/textHint"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
