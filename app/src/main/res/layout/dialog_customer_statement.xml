<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <!-- Optional period: tap either field to open a date picker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_statement_from"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:hint="@string/from_date"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_size_small" />

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tv_statement_to"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:hint="@string/to_date"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_size_small" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_statement_share"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/statement_share_pdf"
        android:textSize="@dimen/text_size_body"
        app:backgroundTint="@color/primaryColor"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_share"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_statement_view"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:elevation="0dp"
        android:text="@string/statement_view_pdf"
        android:textColor="@color/primaryColor"
        android:textSize="@dimen/text_size_body"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_reports"
        app:iconGravity="textStart"
        app:iconTint="@color/primaryColor" />
</LinearLayout>
