<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Base theme — navy brand, RTL, light blue-grey surface.
         ============================================================ -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/primaryColor</item>
        <item name="colorSecondary">@color/primaryColor</item>
        <item name="android:statusBarColor">@color/primaryDarkColor</item>
        <item name="android:windowBackground">@color/lightGray</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <!-- Force RTL for Arabic -->
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">anyRtl</item>
        <item name="android:textAlignment">viewStart</item>
        <!-- One primary button style everywhere (outlined/text buttons keep their own style) -->
        <item name="materialButtonStyle">@style/PrimaryButton</item>
    </style>

    <!-- ============================================================
         Toolbar — one style for every screen
         ============================================================ -->
    <style name="AppTheme.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/primaryColor</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/TextAppearance.AlMajd.ToolbarTitle</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ============================================================
         Typography
         ============================================================ -->
    <style name="TextAppearance.AlMajd.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.AlMajd.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.AlMajd.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.AlMajd.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="TextAppearance.AlMajd.NumberLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.AlMajd.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ============================================================
         Cards — radius 16dp, elevation 1-2dp
         ============================================================ -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="contentPadding">0dp</item>
        <item name="android:layout_margin">@dimen/card_margin</item>
    </style>

    <!-- ============================================================
         Inputs — outlined, 1dp #CBD5E1, radius 12dp, white, 52dp
         ============================================================ -->
    <style name="AppTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/inputBorder</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/textHint</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxBackgroundColor">@color/inputBackground</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
    </style>

    <!-- EditText inside a TextInputLayout -->
    <style name="InputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Stand-alone EditText (no TextInputLayout wrapper): same outline look -->
    <style name="InputTextBox" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
        <item name="android:paddingStart">@dimen/input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/input_padding_horizontal</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <!-- Compact variant for the 3 inline invoice-line fields on a 360dp screen.
         Same border / radius / white background, reduced horizontal padding so
         the quantity column stays usable. -->
    <style name="InputTextBox.LineItem">
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- ============================================================
         Buttons — radius 14dp, height 52dp
         ============================================================ -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <!-- Use the Material elevation attr, not android:elevation. The theme's
             materialButtonStyle is also consulted as a fallback for buttons with
             an explicit TextButton/OutlinedButton style; android:elevation there
             leaked a shadow onto those flat buttons (grey "double frame"). -->
        <item name="elevation">1dp</item>
    </style>

    <!-- Success button -->
    <style name="SuccessButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/green</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- Danger button -->
    <style name="DangerButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/red</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- Ghost button -->
    <style name="GhostButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/ghostBackground</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Outline button -->
    <style name="OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/primaryColor</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Extended FAB used by the customer, order and payment lists. -->
    <style name="AlMajd.ExtendedFab" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">4dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@android:color/transparent</item>
    </style>

    <!-- Dashboard nav cards (kept for compatibility) -->
    <style name="DashboardButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/nav_card_height</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/card_corner_radius</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="rippleColor">@color/rippleColor</item>
    </style>

    <!-- List filter chips: neutral until selected, then navy with white text.
         No stroke and no elevation, so they stay flat inside the search panel. -->
    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:elevation">0dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipBackgroundColor">@color/filter_chip_background</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/rippleColor</item>
    </style>

    <!-- Status badge (paid/unpaid/partial) -->
    <style name="StatusBadge">
        <item name="android:textSize">@dimen/text_size_tiny</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/badge_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/badge_padding_vertical</item>
    </style>

    <!-- Section header text -->
    <style name="SectionHeader">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
