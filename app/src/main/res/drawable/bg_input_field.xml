<?xml version="1.0" encoding="utf-8"?>
<!-- Shared outlined input background for stand-alone EditTexts / date fields -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/inputBackground" />
    <stroke
        android:width="1dp"
        android:color="@color/inputBorder" />
    <corners android:radius="@dimen/input_corner_radius" />
</shape>
